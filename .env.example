# Base URL of the internal commerce API.
#
# Server-only. Never expose this as NEXT_PUBLIC_*: the API lives on a private
# network and the browser has no reason to learn its address (ADR-0001).
#
# The value below is a PLACEHOLDER and does not resolve. Until the real backend
# exists, do not copy it into .env and run `pnpm dev` — every catalog request
# will fail with ENOTFOUND. Use the mock instead:
#
#     pnpm dev:mock
#
# which starts scripts/mock-api.mjs and sets COMMERCE_API_URL to it for that
# process, overriding whatever is in .env.
COMMERCE_API_URL=https://commerce.internal/v1

# Public origin of the storefront, used for SEO metadata (canonical URLs,
# Open Graph, Twitter cards). Required for any environment that runs the app
# under a real origin. Replace with the production domain when it is known.
STOREFRONT_URL=https://storefront.example

# Shared secret for the catalog invalidation webhook (POST /api/revalidate).
# The route returns 503 when this is unset, so the endpoint is inert until you
# configure it. Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=

# OpenTelemetry. Tracing is registered only when the endpoint below is set, so
# leaving it empty means no exporter and no traces — not a broken one.
#
# Setting it is what makes "is the PDP slow because of us or because of the
# commerce API?" answerable: the outbound client injects W3C traceparent, so the
# storefront span and the backend span belong to one trace.
#
# No collector exists for this project yet; point this at one when it does.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=storefront

# HUB catalog API (hub.reprint.ro). Read-only product/category/pricing feed.
#
# Server-only: the secret signs every request and must never be exposed to the
# browser, so none of these may be prefixed NEXT_PUBLIC_.
#
# Requests are signed HMAC-SHA256, hex, over:
#   METHOD \n PATH-INCLUDING-QUERY \n BODY \n UNIX-TIMESTAMP
# The signing window is 5 minutes, so a skewed server clock presents as
# `unauthorized` rather than as a clock problem — check the clock first.
#
# The storefront degrades rather than failing when these are unset.
HUB_API_URL=https://hub.reprint.ro
HUB_API_KEY=
HUB_API_SECRET=

# Session checkout: each order is emailed to the shop via Resend's HTTP API.
# Without all three, checkout refuses every order rather than dropping it.
# ORDER_EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=

# The shop's WhatsApp number, with the country code: +40 7xx xxx xxx.
# Optional. Without it the "Discută pe WhatsApp" buttons on the product page and
# in the cart are simply absent. Spaces and the plus sign are ignored.
WHATSAPP_NUMBER=

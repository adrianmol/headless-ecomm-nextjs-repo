# Base URL of the internal commerce API.
#
# Server-only. Never expose this as NEXT_PUBLIC_*: the API lives on a private
# network and the browser has no reason to learn its address (ADR-0001).
#
# The value below is a PLACEHOLDER and does not resolve. Until the real backend
# exists, do not copy it into .env and run `pnpm dev` — every catalog request
# will fail with ENOTFOUND. Use the mock instead:
#
#     pnpm dev:mock
#
# which starts scripts/mock-api.mjs and sets COMMERCE_API_URL to it for that
# process, overriding whatever is in .env.
COMMERCE_API_URL=https://commerce.internal/v1

# Shared secret for the catalog invalidation webhook (POST /api/revalidate).
# The route returns 503 when this is unset, so the endpoint is inert until you
# configure it. Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=

# OpenTelemetry. Tracing is registered only when the endpoint below is set, so
# leaving it empty means no exporter and no traces — not a broken one.
#
# Setting it is what makes "is the PDP slow because of us or because of the
# commerce API?" answerable: the outbound client injects W3C traceparent, so the
# storefront span and the backend span belong to one trace.
#
# No collector exists for this project yet; point this at one when it does.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=storefront

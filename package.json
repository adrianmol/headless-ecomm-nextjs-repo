{
  "name": "headless-ecomm-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node scripts/with-mock-api.mjs next dev",
    "build": "next build",
    "start": "node scripts/serve-standalone.mjs",
    "build:ci": "node scripts/with-mock-api.mjs next build",
    "start:ci": "node scripts/with-mock-api.mjs node scripts/serve-standalone.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "codegen": "openapi-typescript openapi/commerce.yaml -o src/commerce/api.ts",
    "codegen:check": "pnpm codegen && git diff --exit-code src/commerce/api.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@radix-ui/react-slot": "1.3.3",
    "@vercel/otel": "2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.6",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5"
}
